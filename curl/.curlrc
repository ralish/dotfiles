# curl
# https://curl.se/
#
# File paths in preference order (Unix-like):
# - `$CURL_HOME/.curlrc`
# - `$XDG_CONFIG_HOME/curlrc`
# - `$HOME/.curlrc`
# - `$CURL_HOME/.config/curlrc`
#   Only if `$XDG_CONFIG_HOME` is unset.
# - `$HOME/.config/curlrc`
#   Only if `$XDG_CONFIG_HOME` is unset.
# - `<HomeDir>/.curlrc`
#   `<HomeDir>` is as returned by `getpwuid`.
#
# File paths in preference order (Windows):
# - `%CURL_HOME%\.curlrc`, `%CURL_HOME%\_curlrc`
# - `%XDG_CONFIG_HOME%\curlrc`
# - `%HOME%\.curlrc`
#   Also checks for `_curlrc` if `%XDG_CONFIG_HOME%` is unset.
# - `%USERPROFILE%\.curlrc`
#   Also checks for `_curlrc` if `%XDG_CONFIG_HOME%` is unset.
# - `%APPDATA%\.curlrc`
#   Also checks for `_curlrc` if `%XDG_CONFIG_HOME%` is unset.
# - `%USERPROFILE%\Application Data\.curlrc`
#   Also checks for `_curlrc` if `%XDG_CONFIG_HOME%` is unset.
# - `%CURL_HOME%\.config\curlrc`
#   Only if `%XDG_CONFIG_HOME%` is unset.
# - `%HOME%\.config\curlrc`
#   Only if `%XDG_CONFIG_HOME%` is unset.
# - `<BinDir>\.curlrc`
#   `<BinDir>` is the directory of the executable. If `%XDG_CONFIG_HOME%` is
#   unset then `_curlrc` is also checked.

# Request compressed responses and automatically decompress the content
compressed

# Fail with error code 22 and no response body for HTTP response codes >= 400
fail

# Automatically retry the request with the new location on HTTP 3xx responses
location

# Use the previous URL for the `Referer` header when following a redirect
referer = ";auto"

# Override the default `curl/<version>` user agent
user-agent = "Mozilla/5.0 (Windows NT 10.0; Trident/7.0; rv:11.0) like Gecko"

# vim: syntax=conf cc=80 tw=79 ts=4 sw=4 sts=4 et sr
