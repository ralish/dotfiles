# Script files should always be LF terminated
*.sh                            text        eol=lf
*.bash                          text        eol=lf
*.fish                          text        eol=lf
*.zsh                           text        eol=lf
.bashrc                         text        eol=lf
.cshrc                          text        eol=lf
.mk-sbuild.rc                   text        eol=lf
.quiltrc                        text        eol=lf
.shellcheckrc                   text        eol=lf
.startxwinrc                    text        eol=lf
.tcshrc                         text        eol=lf
.zshrc                          text        eol=lf
user-dirs.dirs                  text        eol=lf
git/bin/*                       text        eol=lf
git/hooks/*                     text        eol=lf
openssh/bin/*                   text        eol=lf
scripts/bin/*                   text        eol=lf

# Remote Desktop Connection files should be UTF-16LE
*.rdp                           working-tree-encoding=UTF-16LE-BOM
mstsc/Template.ini              working-tree-encoding=UTF-16LE-BOM

# Windows Registry files should be UTF-16LE
*.reg                           working-tree-encoding=UTF-16LE-BOM

# Language detection overrides for Linguist
*.inf                           linguist-language=ini
*.vsconfig                      linguist-language=json
*.wsb                           linguist-language=xml
.psqlrc                         linguist-language=plpgsql
.stow-local-ignore              linguist-language=ignore
.wslconfig                      linguist-language=ini
.vscode/*.json                  linguist-language=jsonc
office/**/*.cls                 linguist-language=vba
themes/**/dircolors.*           linguist-language=dircolors
tmux/**/*.conf                  linguist-language=shell
vscode/*.json                   linguist-language=jsonc
winget/*.json                   linguist-language=jsonc
winterm/*.json                  linguist-language=jsonc

# Exclude vendored code from Linguist language detection
stow/**                         linguist-vendored
themes/**                       linguist-vendored
vim/.vim/autoload/**            linguist-vendored

