# ShellCheck settings
# https://github.com/koalaman/shellcheck
#
# Last reviewed release: v0.11.0
#
# File paths in preference order (Unix-like):
# - `.shellcheckrc`, `shellcheckrc`
#   Script directory and each parent directory.
# - `$HOME/.shellcheckrc`
# - `${XDG_CONFIG_HOME:-$HOME/.config}/shellcheckrc`
#
# File paths in preference order (Windows):
# - `.shellcheckrc`, `shellcheckrc`
#   Script directory and each parent directory.
# - `%APPDATA%\shellcheckrc`
# - `%XDG_CONFIG_HOME%\shellcheckrc`
#   Defaults to `%APPDATA%` making it equal to the previously checked path.

# List of optional checks to enable
enable=all

# List of checks to disable
#
# Check ID          Symbolic name                   Type
# SC2250            require-variable-braces         optional
disable=SC2250

# Add the script directory to the search path for source statements
source-path=SCRIPTDIR

# vim: syntax=conf cc=80 tw=79 ts=4 sw=4 sts=4 et sr
