<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>DotFiles.Maintenance.UpdateAllTheThings</Name>
            <ViewSelectedBy>
                <TypeName>DotFiles.Maintenance.UpdateAllTheThings</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>Windows</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Windows</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Windows = $PSItem.Windows

                                    if ($null -eq $Windows) { return }
                                    if ($Windows -is [Management.Automation.ErrorRecord]) { return $Windows.Exception.Message }

                                    return $Windows.Summary
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>WSL</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>WSL</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $WSL = $PSItem.WSL

                                    if ($null -eq $WSL) { return }
                                    if ($WSL -is [Management.Automation.ErrorRecord]) { return $WSL.Exception.Message }

                                    if (!$WSL.Success) { return 'Error during operation (view property for details)' }
                                    if ($WSL.WhatIf) { return "$($WSL.BeforeUpdate.WSL) (current version)" }

                                    if ($WSL.BeforeUpdate.WSL -eq $WSL.AfterUpdate.WSL) {return "$($WSL.BeforeUpdate.WSL) (no update)" }
                                    return "$($WSL.AfterUpdate.WSL) (previous: $($WSL.BeforeUpdate.WSL))"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Office</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Office</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Office = $PSItem.Office

                                    if ($null -eq $Office) { return }
                                    if ($Office -is [Management.Automation.ErrorRecord]) { return $Office.Exception.Message }

                                    if (!$Office.Success) { return 'Error during operation (view property for details)' }
                                    if ($Office.WhatIf) { return "$($Office.BeforeUpdate) (current version)" }

                                    if ($Office.BeforeUpdate -eq $Office.AfterUpdate) { return "$($Office.BeforeUpdate) (no update)" }
                                    return "$($Office.AfterUpdate) (previous: $($Office.BeforeUpdate))"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>VisualStudio</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>VisualStudio</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $VisualStudio = $PSItem.VisualStudio

                                    if ($null -eq $VisualStudio) { return }
                                    if ($VisualStudio -is [Management.Automation.ErrorRecord]) { return $VisualStudio.Exception.Message }

                                    if (!$VisualStudio.Success) { return 'Error during operation (view property for details)' }
                                    if ($VisualStudio.WhatIf) { return "$([String]::Join(', ', ($VisualStudio.BeforeUpdate.InstallationVersion | Sort-Object))) (current versions)" }

                                    $Updated = $false
                                    foreach ($VsBefore in $VisualStudio.BeforeUpdate) {
                                        $VsAfter = $VisualStudio.AfterUpdate | Where-Object InstanceId -EQ $VsBefore.InstanceId
                                        if ($VsBefore.InstallationVersion -ne $VsAfter.InstallationVersion) { $Updated = $true; break }
                                    }

                                    $BeforeUpdate = [String]::Join(', ', ($VisualStudio.BeforeUpdate.InstallationVersion | Sort-Object))
                                    if (!$Updated) { return "${BeforeUpdate} (no updates)" }

                                    $AfterUpdate = [String]::Join(', ', ($VisualStudio.AfterUpdate.InstallationVersion | Sort-Object))
                                    return "${AfterUpdate} (previous: ${BeforeUpdate})"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>PowerShell</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>PowerShell</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $PowerShell = $PSItem.PowerShell

                                    if ($null -eq $PowerShell) { return }
                                    if ($PowerShell -is [Management.Automation.ErrorRecord]) { return $PowerShell.Exception.Message }

                                    return $PowerShell
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>MicrosoftStore</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>MicrosoftStore</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $MicrosoftStore = $PSItem.MicrosoftStore

                                    if ($null -eq $MicrosoftStore) { return }
                                    if ($MicrosoftStore -is [Management.Automation.ErrorRecord]) { return $MicrosoftStore.Exception.Message }

                                    if (!$MicrosoftStore.Success) { return 'Error during operation (view property for details)' }
                                    if ($MicrosoftStore.WhatIf) { return 'Did not run (WhatIf mode)' }

                                    return 'Updated all apps'
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Edge</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Edge</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Edge = $PSItem.Edge

                                    if ($null -eq $Edge) { return }
                                    if ($Edge -is [Management.Automation.ErrorRecord]) { return $Edge.Exception.Message }

                                    if (!$Edge.Success) { return 'Error during operation (view property for details)' }
                                    if ($Edge.WhatIf) { return "$($Edge.BeforeUpdate) (current version)" }

                                    if ($Edge.BeforeUpdate -eq $Edge.AfterUpdate) { return "$($Edge.BeforeUpdate) (no update)" }
                                    return "Updated to $($Edge.AfterUpdate) (previous: $($Edge.BeforeUpdate))"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Chrome</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Chrome</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Chrome = $PSItem.Chrome

                                    if ($null -eq $Chrome) { return }
                                    if ($Chrome -is [Management.Automation.ErrorRecord]) { return $Chrome.Exception.Message }

                                    if (!$Chrome.Success) { return 'Error during operation (view property for details)' }
                                    if ($Chrome.WhatIf) { return "$($Chrome.BeforeUpdate) (current version)" }

                                    if ($Chrome.BeforeUpdate -eq $Chrome.AfterUpdate) { return "$($Chrome.BeforeUpdate) (no update)" }
                                    return "Updated to $($Chrome.AfterUpdate) (previous: $($Chrome.BeforeUpdate))"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>WinGet</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>WinGet</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $WinGet = $PSItem.WinGet

                                    if ($null -eq $WinGet) { return }
                                    if ($WinGet -is [Management.Automation.ErrorRecord]) { return $WinGet.Exception.Message }

                                    if (!$WinGet.Success) { return 'Error during operation (view property for details)' }
                                    if ($WinGet.WhatIf) { return "$($WinGet.Available.Count) available updates" }

                                    $Updated = ($WinGet.Results | Where-Object Status -EQ 'OK' | Measure-Object).Count
                                    $Failed = $WinGet.Results.Count - $Updated
                                    $Unknown = $WinGet.Available.Count - $WinGet.Results.Count
                                    return "${Updated} packages updated (${Failed} failed, ${Unknown} missing)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Homebrew</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Homebrew</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Homebrew = $PSItem.Homebrew

                                    if ($null -eq $Homebrew) { return }
                                    if ($Homebrew -is [Management.Automation.ErrorRecord]) { return $Homebrew.Exception.Message }

                                    $Actions = [Collections.Generic.List[String]]::new()
                                    if ($Homebrew.Brew.Count -gt 0) { $Actions.Add('Updated Homebrew') }

                                    if ($Homebrew.Apps.Count -gt 0) {
                                        $Action = 'Upgraded apps'
                                        if ($Homebrew.WhatIf) { $Action += ' (dry-run)' }
                                        $Actions.Add($Action)
                                    }

                                    if ($Homebrew.Cleanup.Count -gt 0) {
                                        $Action = 'Cleaned-up outdated data'
                                        if ($Homebrew.WhatIf) { $Action += ' (dry-run)' }
                                        $Actions.Add($Action)
                                    }

                                    if ($Actions.Count -eq 0) { return 'Performed no actions' }
                                    return [String]::Join(', ', $Actions)
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Scoop</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Scoop</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Scoop = $PSItem.Scoop

                                    if ($null -eq $Scoop) { return }
                                    if ($Scoop -is [Management.Automation.ErrorRecord]) { return $Scoop.Exception.Message }

                                    $Actions = [Collections.Generic.List[String]]::new()
                                    if ($Scoop.Scoop.Count -gt 0) { $Actions.Add('Updated Scoop') }

                                    if ($Scoop.Apps.Count -gt 0) {
                                        $Action = 'Updated apps'
                                        if ($Scoop.WhatIf) { $Action += ' (dry-run)' }
                                        $Actions.Add($Action)
                                    }

                                    if ($Scoop.Cleanup.Count -gt 0) { $Actions.Add('Cleaned-up outdated data') }

                                    if ($Actions.Count -eq 0) { return 'Performed no actions' }

                                    $Summary = [String]::Join(', ', $Actions)
                                    return $Summary.Substring(0, 1) + $Summary.Substring(1).ToLower()
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>DotNetTools</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>DotNetTools</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $DotNetTools = $PSItem.DotNetTools

                                    if ($null -eq $DotNetTools) { return }
                                    if ($DotNetTools -is [Management.Automation.ErrorRecord]) { return $DotNetTools.Exception.Message }

                                    if (!$DotNetTools.Success) { return 'Error during operation (view property for details)' }
                                    if ($DotNetTools.WhatIf) { return 'Successful dry-run (view property for details)' }

                                    return 'Success (view property for details)'
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>GoBinaries</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>GoBinaries</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $GoBinaries = $PSItem.GoBinaries

                                    if ($null -eq $GoBinaries) { return }
                                    if ($GoBinaries -is [Management.Automation.ErrorRecord]) { return $GoBinaries.Exception.Message }

                                    if (!$GoBinaries.Success) { return 'Error during operation (view property for details)' }
                                    if ($GoBinaries.WhatIf) { return 'Successful dry-run (view property for details)' }

                                    return 'Success (view property for details)'
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>NodejsPackages</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>NodejsPackages</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $NodejsPackages = $PSItem.NodejsPackages

                                    if ($null -eq $NodejsPackages) { return }
                                    if ($NodejsPackages -is [Management.Automation.ErrorRecord]) { return $NodejsPackages.Exception.Message }

                                    return "$($NodejsPackages.Count) lines (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Python</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>Python</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $Python = $PSItem.Python

                                    if ($null -eq $Python) { return }
                                    if ($Python -is [Management.Automation.ErrorRecord]) { return $Python.Exception.Message }

                                    if (!$Python.Success) { return 'Error during operation (view property for details)' }
                                    if ($Python.WhatIf) { return "$([String]::Join(', ', $Python.BeforeUpdate)) (current versions)" }

                                    $Updated = $false
                                    foreach ($PyBefore in $Python.BeforeUpdate) {
                                        if ($PyBefore -notin $Python.AfterUpdate) { $Updated = $true; break }
                                    }

                                    $BeforeUpdate = [String]::Join(', ', ($Python.BeforeUpdate | Sort-Object))
                                    if (!$Updated) { return "${BeforeUpdate} (no updates)" }

                                    $AfterUpdate = [String]::Join(', ', ($Python.AfterUpdate | Sort-Object))
                                    return "${AfterUpdate} (previous: ${BeforeUpdate})"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>PythonPipPackages</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>PythonPipPackages</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $PythonPipPackages = $PSItem.PythonPipPackages

                                    if ($null -eq $PythonPipPackages) { return }
                                    if ($PythonPipPackages -is [Management.Automation.ErrorRecord]) { return $PythonPipPackages.Exception.Message }

                                    return "$($PythonPipPackages.Count) lines (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>PythonPipxPackages</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>PythonPipxPackages</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $PythonPipxPackages = $PSItem.PythonPipxPackages

                                    if ($null -eq $PythonPipxPackages) { return }
                                    if ($PythonPipxPackages -is [Management.Automation.ErrorRecord]) { return $PythonPipxPackages.Exception.Message }

                                    return "$($PythonPipxPackages.Count) lines (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>QtComponents</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>QtComponents</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $QtComponents = $PSItem.QtComponents

                                    if ($null -eq $QtComponents) { return }
                                    if ($QtComponents -is [Management.Automation.ErrorRecord]) { return $QtComponents.Exception.Message }

                                    return "$($QtComponents.Count) lines (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>RubyGems</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>RubyGems</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $RubyGems = $PSItem.RubyGems

                                    if ($null -eq $RubyGems) { return }
                                    if ($RubyGems -is [Management.Automation.ErrorRecord]) { return $RubyGems.Exception.Message }

                                    return "$($RubyGems.Count) lines (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>RustToolchains</Label>
                                <ItemSelectionCondition>
                                    <PropertyName>RustToolchains</PropertyName>
                                </ItemSelectionCondition>
                                <ScriptBlock>
                                    $RustToolchains = $PSItem.RustToolchains

                                    if ($null -eq $RustToolchains) { return }
                                    if ($RustToolchains -is [Management.Automation.ErrorRecord]) { return $RustToolchains.Exception.Message }

                                    return "$($RustToolchains.Count) lines (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
    </ViewDefinitions>
</Configuration>