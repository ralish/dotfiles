<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>DotFiles.DevEnv.UpdateDotNetTools</Name>
            <ViewSelectedBy>
                <TypeName>DotFiles.DevEnv.UpdateDotNetTools</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>Success</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>WhatIf</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>BeforeUpdate</Label>
                                <ScriptBlock>
                                    $DotNetTools = $PSItem

                                    if ($DotNetTools.BeforeUpdate.Count -eq 0) { return '(no output)' }
                                    if ($DotNetTools.BeforeUpdate.Count -eq 1) { return 'Parse error (view property for output)' }
                                    return "$($DotNetTools.BeforeUpdate.Count - 2) tools installed"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>AfterUpdate</Label>
                                <ScriptBlock>
                                    $DotNetTools = $PSItem

                                    if ($DotNetTools.AfterUpdate.Count -eq 0) { return '(no output)' }
                                    if ($DotNetTools.AfterUpdate.Count -eq 1) { return 'Parse error (view property for output)' }
                                    if ($DotNetTools.BeforeUpdate.Count -ne $DotNetTools.AfterUpdate.Count) { return 'Package count after update differs from before update' }

                                    $Updated = $Total = 0
                                    for ($LineNum = 2; $LineNum -lt $DotNetTools.AfterUpdate.Count; $LineNum++) {
                                        $Elements = $DotNetTools.BeforeUpdate[$LineNum].Split(' ', [StringSplitOptions]::RemoveEmptyEntries)
                                        $BeforePkgId = $Elements[0]
                                        $BeforePkgVersion = $Elements[1]

                                        $Elements = $DotNetTools.AfterUpdate[$LineNum].Split(' ', [StringSplitOptions]::RemoveEmptyEntries)
                                        $AfterPkgId = $Elements[0]
                                        $AfterPkgVersion = $Elements[1]

                                        if ($BeforePkgId -ne $AfterPkgId) {
                                            return "Package name before update differs from after update: ${BeforePkgId} != ${AfterPkgId}"
                                        }

                                        if ($BeforePkgVersion -ne $AfterPkgVersion) { $Updated++ }
                                    }

                                    return "${Updated} tools updated ($($DotNetTools.AfterUpdate.Count - 2) tools installed)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Output</Label>
                                <ScriptBlock>
                                    $DotNetTools = $PSItem

                                    switch ($DotNetTools.Output.Count) {
                                        0 { '(no output)' }
                                        1 { $DotNetTools.Output }
                                        default { "$($DotNetTools.Output.Count) lines (view property for output)" }
                                    }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ExitCode</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <View>
            <Name>DotFiles.DevEnv.UpdateGoBinaries</Name>
            <ViewSelectedBy>
                <TypeName>DotFiles.DevEnv.UpdateGoBinaries</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>Success</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>WhatIf</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Gup</Label>
                                <ScriptBlock>
                                    $GoBinaries = $PSItem

                                    if ($GoBinaries.Gup.Count -eq 0) { return '(no output)' }

                                    foreach ($Line in $GoBinaries.Gup) {
                                        if ($Line -match '^\[1/1\] .+') {
                                            switch -Regex ($Line) {
                                                'Already up-to-date: v(\S+)' { return "$($Matches[1]) (up-to-date)" }
                                                'v(\S+) to v(\S+),' { return "$($Matches[2]) (previous: $($Matches[1]))" }
                                                'go\S+ to go\S+' { return 'Up-to-date' }
                                                'current: v(\S+), latest: v(\S+)' { return "$($Matches[1]) (available: $($Matches[2]))" }
                                            }
                                        }
                                    }

                                    return 'Parse error (view property for output)'
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Binaries</Label>
                                <ScriptBlock>
                                    $GoBinaries = $PSItem

                                    if ($GoBinaries.Binaries.Count -eq 0) { return '(no output)' }

                                    $ParseError = 'Parse error (view property for output)'

                                    $Current = $Available = $Updated = $Total = 0
                                    foreach ($Line in $GoBinaries.Binaries) {
                                        if ($Line -match '^\[ *[1-9][0-9]*/([1-9][0-9]*)\] .+') {
                                            if ($Total -eq 0) {
                                                $Total = $Matches[1]
                                            } elseif ($Total -ne $Matches[1]) {
                                                return $ParseError
                                            }

                                            switch -Regex ($Line) {
                                                'Already up-to-date: v\S+' { $Current++ }
                                                'v\S+ to v\S+' { $Updated++; break }
                                                'go\S+ to go\S+' { $Current++ }
                                                'current: v\S+, latest: v\S+' { $Available++ }
                                            }
                                        }
                                    }

                                    if ($Updated -gt 0 -and $Available -gt 0) { return $ParseError }

                                    if ($GoBinaries.WhatIf) {
                                        if ($Current + $Available -ne $Total) { return $ParseError }
                                        return "${Available} updates available (view property for output)"
                                    }

                                    if ($Current + $Updated -ne $Total) { return $ParseError }

                                    return "${Updated} binaries updated (view property for output)"
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ExitCode</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
    </ViewDefinitions>
</Configuration>